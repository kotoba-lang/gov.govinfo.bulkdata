#!/usr/bin/env nbb
;; Derives index/ (small, git-tracked) from raw/*.zip (large, annexed).
;;
;;   index/laws.edn       — one row per measure (bill/resolution) and per
;;                          enacted public law, each carrying the ADDRESS of
;;                          its full USLM text: which zip, which entry inside
;;                          it, and that entry's sha256.
;;   index/relations.edn  — <relatedBills> edges (companion / identical /
;;                          procedurally-related measures) and <laws> edges
;;                          (this measure BECAME that public law).
;;   raw/source-catalog.edn — sha256 of each preserved zip.
;;
;; Usage: nbb --classpath bin bin/index.cljs
(ns index
  (:require [lib :refer [log write-edn! sha256 sha256-file file-size mkdirp!]]
            [clojure.string :as str]))

(def fs (js/require "fs"))
(def cp (js/require "child_process"))
(def os (js/require "os"))
(def path-mod (js/require "path"))
(def raw "raw")

(defn unzip-to!
  "Extracts `zip` into a fresh directory and returns it. Uses the system
   unzip: Node has zlib but no archive reader, and adding an npm dependency
   to a preservation dataset would make re-deriving the index require a
   package install years from now. unzip is POSIX."
  [zip dir]
  (.rmSync fs dir #js {:recursive true :force true})
  (.mkdirSync fs dir #js {:recursive true})
  (.execFileSync cp "unzip" #js ["-q" "-o" zip "-d" dir] #js {:stdio "ignore"})
  dir)

(defn entries [dir]
  (->> (.readdirSync fs dir)
       (filter #(str/ends-with? % ".xml"))
       sort))

(defn tag1
  "First <t>...</t> text in s, or nil. These files are machine-generated by
   the Government Publishing Office to a fixed schema, so a regex is a
   legitimate reader here -- this is not arbitrary user XML."
  [s t]
  (when-let [m (.match s (js/RegExp. (str "<" t ">([\\s\\S]*?)</" t ">")))]
    (str/trim (aget m 1))))

(defn top-level-items
  "Splits an XML fragment into its DIRECT <item> children. A naive split on
   </item> is wrong here: <relatedBills><item> contains a nested
   <relationshipDetails><item>, so depth has to be tracked or every related
   bill's relationship type gets attributed to the wrong bill."
  [s]
  (when s
    (let [re (js/RegExp. "<item>|</item>" "g")]
      (loop [depth 0 start nil out []]
        (if-let [m (.exec re s)]
          (let [open? (= "<item>" (aget m 0))
                i (.-index m)]
            (cond
              (and open? (zero? depth)) (recur 1 (+ i 6) out)
              open? (recur (inc depth) start out)
              (= 1 depth) (recur 0 nil (conj out (subs s start i)))
              :else (recur (dec depth) start out)))
          out)))))

(defn measure-key [congress type number]
  (str "us-congress:" congress "-" (str/lower-case type) number))

(def type->kind
  {"HR" :law.kind/bill "S" :law.kind/bill
   "HJRES" :law.kind/joint-resolution "SJRES" :law.kind/joint-resolution
   "HCONRES" :law.kind/concurrent-resolution "SCONRES" :law.kind/concurrent-resolution
   "HRES" :law.kind/simple-resolution "SRES" :law.kind/simple-resolution})

;; BILLS entry names look like BILLS-119hr1ih.xml: <congress><type><number><version>.
(def bill-entry-re (js/RegExp. "^BILLS-(\\d+)([a-z]+)(\\d+)([a-z]+)\\.xml$"))
;; PLAW entry names look like PLAW-119publ21.xml.
(def plaw-entry-re (js/RegExp. "^PLAW-(\\d+)(publ|pvtl)(\\d+)\\.xml$"))

(defn index-text-archives
  "Walks every BILLS/PLAW zip once, recording each entry's sha256 and the
   archive it lives in. Returns {measure-key [text-row ...]} plus the public
   law rows."
  []
  (let [tmp (.join path-mod (.tmpdir os) "govinfo-index")
        bills (atom {})
        plaws (atom [])]
    (doseq [kind ["bills" "plaw"]
            zip (sort (.readdirSync fs (str raw "/" kind)))
            :let [zp (str raw "/" kind "/" zip)
                  dir (unzip-to! zp (str tmp "/" kind))]]
      (doseq [e (entries dir)
              :let [full (str dir "/" e)
                    sha (sha256-file full)
                    bytes (file-size full)]]
        (if-let [m (.match e bill-entry-re)]
          (let [[_ congress typ number version] (array-seq m)
                k (measure-key congress typ number)]
            (swap! bills update k (fnil conj [])
                   {:text/archive zp :text/entry e :text/sha256 sha :text/bytes bytes
                    :text/version version :text/format "uslm-xml"}))
          (when-let [m (.match e plaw-entry-re)]
            (let [[_ congress kindc number] (array-seq m)]
              (swap! plaws conj
                     {:law/key (str "us-publaw:" congress "-" number)
                      :law/jurisdiction "USA"
                      :law/source-id "us-govinfo-plaw"
                      :law/local-id (str congress "-" number)
                      :law/kind (if (= "publ" kindc) :law.kind/public-law :law.kind/private-law)
                      :law/number (str (if (= "publ" kindc) "Public Law " "Private Law ") congress "-" number)
                      :law/title (or (tag1 (.toString (.readFileSync fs full)) "dc:title")
                                     (str "Public Law " congress "-" number))
                      :law/lang "en"
                      :law/status :law.status/enacted
                      :law/url (str "https://www.govinfo.gov/app/details/PLAW-" congress kindc number)
                      :text/archive zp :text/entry e :text/sha256 sha :text/bytes bytes
                      :text/format "uslm-xml"})))))
      (.rmSync fs dir #js {:recursive true :force true}))
    {:bills @bills :plaws @plaws}))

(defn -main []
  (let [{:keys [bills plaws]} (index-text-archives)
        _ (log "text archives indexed:" (count bills) "measures," (count plaws) "public laws")
        tmp (.join path-mod (.tmpdir os) "govinfo-status")
        measures (atom [])
        rels (atom [])]
    (doseq [zip (sort (.readdirSync fs (str raw "/billstatus")))
            :let [zp (str raw "/billstatus/" zip)
                  dir (unzip-to! zp tmp)]]
      (log "billstatus" zip (count (entries dir)) "records")
      (doseq [e (entries dir)
              :let [s (.toString (.readFileSync fs (str dir "/" e)))
                    congress (tag1 s "congress")
                    typ (tag1 s "type")
                    number (tag1 s "number")]
              :when (and congress typ number)]
        (let [k (measure-key congress typ number)
              texts (get bills k)
              law-items (top-level-items (tag1 s "laws"))
              rel-items (top-level-items (tag1 s "relatedBills"))]
          (swap! measures conj
                 (cond-> {:law/key k
                          :law/jurisdiction "USA"
                          :law/source-id "us-govinfo-billstatus"
                          :law/local-id (str congress "-" (str/lower-case typ) number)
                          :law/kind (get type->kind typ :law.kind/other)
                          :law/number (str typ " " number " (" congress "th Congress)")
                          :law/title (or (tag1 s "title") (str typ " " number))
                          :law/lang "en"
                          :law/status (if (seq law-items) :law.status/enacted :law.status/pending)
                          :law/url (str "https://www.congress.gov/bill/" congress "th-congress/"
                                        (if (= "HR" typ) "house-bill"
                                            (if (= "S" typ) "senate-bill" (str/lower-case typ)))
                                        "/" number)}
                   (tag1 s "introducedDate") (assoc :law/introduced-at (tag1 s "introducedDate"))
                   (tag1 s "policyArea") (assoc :law/category (tag1 (tag1 s "policyArea") "name"))
                   (seq texts) (assoc :law/text-versions (vec (sort-by :text/entry texts)))))
          ;; became-law edges
          (doseq [li law-items
                  :let [ln (tag1 li "number")]
                  :when ln]
            (swap! rels conj {:rel/from k
                              :rel/to (str "us-publaw:" ln)
                              :rel/kind :law.rel/became-law
                              :rel/provenance :from-metadata
                              :rel/source-id "us-govinfo-billstatus"}))
          ;; related-measure edges
          (doseq [ri rel-items
                  :let [rc (tag1 ri "congress") rn (tag1 ri "number") rt (tag1 ri "type")]
                  :when (and rc rn rt)]
            (let [details (top-level-items (tag1 ri "relationshipDetails"))
                  kinds (distinct (keep #(tag1 % "type") details))]
              (doseq [kind (or (seq kinds) ["Related bill"])]
                (swap! rels conj {:rel/from k
                                  :rel/to (measure-key rc rt rn)
                                  :rel/kind (case kind
                                              "Identical bill" :law.rel/identical-measure
                                              "Related bill" :law.rel/related-measure
                                              "Procedurally-related" :law.rel/procedurally-related
                                              "Companion measure" :law.rel/companion-measure
                                              :law.rel/related-measure)
                                  :rel/evidence kind
                                  :rel/provenance :from-metadata
                                  :rel/source-id "us-govinfo-billstatus"}))))))
      (.rmSync fs dir #js {:recursive true :force true}))
    (mkdirp! "index")
    (let [rows (into (vec (sort-by :law/key @measures)) (sort-by :law/key plaws))
          edges (vec (sort-by (juxt :rel/from :rel/kind :rel/to) (distinct @rels)))]
      (write-edn! "index/laws.edn"
                  {:index/id "gov.govinfo.bulkdata"
                   :index/jurisdiction "USA"
                   :index/source-id "us-govinfo"
                   :laws rows})
      (write-edn! "index/relations.edn"
                  {:index/id "gov.govinfo.bulkdata"
                   :index/source-id "us-govinfo"
                   :relations edges})
      (write-edn! (str raw "/source-catalog.edn")
                  {:catalog/id "gov.govinfo.bulkdata"
                   :catalog/source-domain "govinfo.gov"
                   :catalog/api "govinfo bulkdata (BILLSTATUS / BILLS / PLAW)"
                   :catalog/license "US federal government edicts: not subject to copyright (17 U.S.C. §105); govinfo publishes these for bulk reuse"
                   :catalog/license-tier :tier/a
                   :catalog/scope "119th Congress: every measure's status record, every bill-version full text, and every enacted public law"
                   :catalog/complete-as-a-class true
                   :catalog/class "119th Congress"
                   :catalog/known-gaps [{:gap :earlier-congresses
                                         :note "same URL shape, different congress number; 113th onward are published"}]
                   :catalog/files
                   (vec (for [kind ["billstatus" "bills" "plaw"]
                              z (sort (.readdirSync fs (str raw "/" kind)))
                              :let [p (str raw "/" kind "/" z)]]
                          {:path p :sha256 (sha256-file p) :bytes (file-size p)
                           :kind (keyword kind)}))})
      (log "measures" (count @measures) "public-laws" (count plaws)
           "with-text" (count (filter :law/text-versions @measures))
           "relations" (count edges)))))

(-main)
